      {/* Modal: Add Dish */}
      <Modal isOpen={isModalOpen} onClose={() => setIsModalOpen(false)} title="Thêm Món Mới Vào Master Menu">
        <form onSubmit={handleSubmitNewDish}>
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px' }}>
