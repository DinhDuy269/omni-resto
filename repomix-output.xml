                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <span style={{ fontSize: '1rem', fontWeight: 800, color: 'var(--c-primary)' }}>
                      {item.basePrice.toLocaleString('vi-VN')}đ
