                <StatusBadge status={dish.status} />
                {dish.isBestSeller && (
                  <span
                    style={{
                      display: 'inline-flex',
                      alignItems: 'center',
                      gap: '5px',
                      padding: '5px 12px',
                      fontSize: '0.78125rem',
                      fontWeight: 800,
                      backgroundColor: 'var(--primary)',
                      color: '#ffffff',
                      borderRadius: 'var(--radius-full)',
                      boxShadow: 'var(--shadow-md)',
