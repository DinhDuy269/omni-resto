          gap: 2px;
        }
        .menu-card__price-value {
          font-size: 1.0625rem;
          font-weight: 800;
          color: var(--c-primary);
        }
        .menu-card__price-unit {
          font-size: 0.8125rem;
          font-weight: 600;
          color: var(--c-primary);
        }

        /* Add button */
        .menu-card__add-btn {
          display: flex;
          align-items: center;
          gap: 5px;
